---
// src/pages/booking.astro — REPLACED
// 4-step booking wizard: Session → Schedule → Details → Review → Confirmed.
// Reads prefill from URL params (minutes, location, service) so HeroBooker
// deep-links land on step 1 with your selection ready.
// Pure Astro + vanilla JS — no frameworks added.

import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import { business } from "../content/business";

const title = "Book a session";
const description =
  "Choose your session, pick a time, enter your details. Card is saved but not charged until after your session.";

const services = [
  { slug: "therapeutic-massage", name: "Therapeutic", short: "Medium to firm pressure on the knots that actually matter." },
  { slug: "deep-tissue-massage", name: "Deep tissue", short: "Slower, deeper work through specific muscle layers." },
  { slug: "relaxation-massage", name: "Relaxation", short: "Steady, flowing pressure. Nervous-system first." },
  { slug: "prenatal-massage", name: "Prenatal", short: "Side-lying, supported. Second and third trimester." },
  { slug: "sports-massage", name: "Sports recovery", short: "Before a race, day after a long effort, or mid-training." },
];

const timeSlots = ["10:00 AM", "11:30 AM", "1:00 PM", "2:30 PM", "4:00 PM", "5:30 PM"];
---

<Layout title={title} description={description} path="/booking">
  <Section class="bg-gradient-to-b from-paper to-paper-soft" titleTag="h1">
    <div class="mx-auto max-w-5xl">
      <div data-booking-wizard-wrap>
      {/* Back link */}
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-ink/70 hover:text-ink" data-back>
        <span aria-hidden="true">←</span> <span data-back-label>Back to home</span>
      </a>

      <div class="mt-6 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        {/* LEFT — steps */}
        <div>
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">
                Step <span data-step-num>1</span> of 4
              </p>
              <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl" data-step-title>
                Pick your session.
              </h1>
            </div>
            <div class="flex items-center gap-1.5" data-step-dots>
              <span class="h-1 w-8 rounded-full bg-sage transition-all"></span>
              <span class="h-1 w-1.5 rounded-full bg-stone-300"></span>
              <span class="h-1 w-1.5 rounded-full bg-stone-300"></span>
              <span class="h-1 w-1.5 rounded-full bg-stone-300"></span>
            </div>
          </div>

          {/* STEP 1 — SESSION */}
          <div class="mt-8 space-y-8" data-step="1">
            {/* Location */}
            <fieldset>
              <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Where</legend>
              <div class="mt-3 grid grid-cols-2 gap-3" data-group="location">
                <button type="button" data-value="house" class="step-option rounded-xl border border-stone-200 bg-white p-4 text-left shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40">
                  <p class="text-base font-semibold text-ink">Your place</p>
                  <p class="mt-1 text-xs text-ink/65">I drive to you · within {business.travel.radiusMiles} mi</p>
                </button>
                <button type="button" data-value="studio" class="step-option rounded-xl border border-stone-200 bg-white p-4 text-left shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40">
                  <p class="text-base font-semibold text-ink">Studio</p>
                  <p class="mt-1 text-xs text-ink/65">Private studio near downtown {business.city}</p>
                </button>
              </div>
            </fieldset>

            {/* Minutes */}
            <fieldset>
              <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">How long</legend>
              <div class="mt-3 grid grid-cols-3 gap-3" data-group="minutes">
                {
                  business.sessionPricing.map((p, i) => (
                    <button
                      type="button"
                      data-value={p.minutes}
                      data-studio-price={p.studioPrice}
                      data-house-price={p.houseCallPrice}
                      class="step-option rounded-xl border border-stone-200 bg-white p-4 text-center shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40"
                    >
                      <p class="text-3xl font-semibold leading-none tracking-tight text-ink">{p.minutes}</p>
                      <p class="mt-1 text-[10px] font-semibold uppercase tracking-wide text-ink/60">minutes</p>
                      <p class="mt-2 font-mono text-sm text-ink/70" data-dur-price>${p.houseCallPrice}</p>
                      {i === 1 ? (
                        <p class="mt-1.5 text-[10px] font-semibold uppercase tracking-wide text-sage">Most booked</p>
                      ) : null}
                    </button>
                  ))
                }
              </div>
            </fieldset>

            {/* Service */}
            <fieldset>
              <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Style</legend>
              <div class="mt-3 grid gap-2 sm:grid-cols-2" data-group="service">
                {
                  services.map((s) => (
                    <button type="button" data-value={s.slug} class="step-option rounded-xl border border-stone-200 bg-white p-4 text-left shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40">
                      <p class="text-sm font-semibold text-ink">{s.name}</p>
                      <p class="mt-1 text-xs text-ink/65">{s.short}</p>
                    </button>
                  ))
                }
              </div>
            </fieldset>
          </div>

          {/* STEP 2 — SCHEDULE */}
          <div class="mt-8 hidden space-y-8" data-step="2">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Pick a day</p>
              <div class="mt-3 flex gap-2 overflow-x-auto pb-1" data-group="date" data-days-strip></div>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Pick a time</p>
              <p class="mt-2 hidden text-sm italic text-ink/60" data-times-empty>Select a day first.</p>
              <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3" data-group="time">
                {
                  timeSlots.map((t) => (
                    <button type="button" data-value={t} class="step-option rounded-xl border border-stone-200 bg-white p-3 text-center shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40">
                      <p class="font-mono text-sm text-ink">{t}</p>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          {/* STEP 3 — DETAILS */}
          <div class="mt-8 hidden space-y-5" data-step="3">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Full name</span>
                <input type="text" name="name" data-field required
                  class="mt-1.5 block h-11 w-full rounded-xl border border-stone-200 bg-white px-3 text-sm text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-1 focus:ring-sage"
                  placeholder="Jordan Rivera" />
              </label>
              <label class="block">
                <span class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Phone</span>
                <input type="tel" name="phone" data-field required
                  class="mt-1.5 block h-11 w-full rounded-xl border border-stone-200 bg-white px-3 text-sm text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-1 focus:ring-sage"
                  placeholder={business.phoneDisplay} />
              </label>
            </div>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Email</span>
              <input type="email" name="email" data-field required
                class="mt-1.5 block h-11 w-full rounded-xl border border-stone-200 bg-white px-3 text-sm text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-1 focus:ring-sage"
                placeholder="you@example.com" />
            </label>
            <label class="block" data-field-wrap="address">
              <span class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Address</span>
              <input type="text" name="address" data-field
                class="mt-1.5 block h-11 w-full rounded-xl border border-stone-200 bg-white px-3 text-sm text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-1 focus:ring-sage"
                placeholder={`123 Main St, ${business.city}, ${business.state}`} />
              <span class="mt-1.5 block text-xs text-ink/55">Include apartment or gate code if relevant.</span>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-clay-deep">
                What's your body asking for? <span class="ml-1 font-normal normal-case tracking-normal text-ink/55">(optional)</span>
              </span>
              <textarea name="notes" data-field rows="3"
                class="mt-1.5 block w-full rounded-xl border border-stone-200 bg-white px-3 py-2.5 text-sm text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-1 focus:ring-sage"
                placeholder="Tight low back from sitting, shoulder from an old injury, etc."></textarea>
            </label>
          </div>

          {/* STEP 4 — REVIEW */}
          <div class="mt-8 hidden space-y-5" data-step="4">
            <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
              <dl class="divide-y divide-stone-200 text-sm">
                <div class="flex items-baseline justify-between gap-4 pb-3">
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Session</dt>
                  <dd class="text-right text-ink" data-review-session>—</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">When</dt>
                  <dd class="text-right text-ink" data-review-when>—</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Where</dt>
                  <dd class="text-right text-ink" data-review-where>—</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Name</dt>
                  <dd class="text-right text-ink" data-review-name>—</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Contact</dt>
                  <dd class="text-right text-ink" data-review-contact>—</dd>
                </div>
                <div class="hidden pt-3" data-review-notes-wrap>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Notes</dt>
                  <dd class="mt-1 text-ink/80" data-review-notes></dd>
                </div>
              </dl>
            </div>
            <div class="flex items-start gap-3 rounded-2xl border border-stone-200 bg-paper-soft p-5 text-sm text-ink/75">
              <span aria-hidden="true" class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-white text-xs font-bold text-sage">✓</span>
              <p class="leading-relaxed">
                Your card is saved for holding the slot and charged after the session. Cancel up to 24 hours before for no charge. {business.texasLicenseNumber}.
              </p>
            </div>
          </div>

          {/* Nav */}
          <div class="mt-8 flex items-center justify-between gap-3">
            <p class="text-xs text-ink/55" data-helper>
              Pressure, pace, focus — we'll fine-tune in person.
            </p>
            <Button variant="primary" class="!px-6 !py-3"><span data-next-label>Continue →</span></Button>
          </div>
        </div>

        {/* RIGHT — sticky summary */}
        <aside class="lg:sticky lg:top-24">
          <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Your booking</p>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-ink" data-summary-title>Therapeutic · 90 min</h2>
            <p class="mt-0.5 text-sm text-ink/65" data-summary-location>House call</p>

            <dl class="mt-5 space-y-3 text-sm">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">When</dt>
                <dd class="text-right text-ink" data-summary-when>—</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Where</dt>
                <dd class="text-right text-ink" data-summary-where>—</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Name</dt>
                <dd class="text-right text-ink" data-summary-name>—</dd>
              </div>
            </dl>

            <div class="mt-5 space-y-2 border-t border-stone-200 pt-5 text-sm">
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-ink/70">Session</span>
                <span class="font-mono tabular-nums text-ink" data-summary-price>$195</span>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-ink/70">Travel (within {business.travel.radiusMiles} mi)</span>
                <span class="font-mono tabular-nums text-ink/60">Included</span>
              </div>
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-4 border-t border-stone-200 pt-4">
              <span class="text-lg font-semibold tracking-tight text-ink">Total</span>
              <span class="text-2xl font-semibold tracking-tight text-ink" data-summary-total>$195</span>
            </div>

            <p class="mt-5 border-t border-stone-200 pt-5 text-xs leading-relaxed text-ink/60">
              Charged after the session. 24-hour cancellation. Gratuity not expected.
            </p>
          </div>

          {/* Fallback */}
          <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-relaxed text-ink/80">
            Booking page acting up? Text{" "}
            <a class="font-semibold text-sage hover:text-sage-dark" href={`sms:${business.phoneTel}`}>{business.phoneDisplay}</a>{" "}
            with your session type, location, and a few times that work.
          </div>
        </aside>
      </div>
      </div>

      {/* CONFIRMED — hidden until submit */}
      <div class="mt-10 hidden" data-confirmed>
        <div class="mx-auto max-w-xl rounded-3xl border border-stone-200 bg-white p-10 text-center shadow-card">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-sage/10 text-2xl text-sage">✓</div>
          <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-clay-deep">Confirmation sent</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Your hour is held.</h2>
          <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink/70">
            A confirmation is on its way to <span class="text-ink" data-confirmed-email>your email</span>.
            I'll text the day before with arrival notes.
          </p>
          <div class="mt-8 flex items-center justify-center gap-2">
            <Button href="/" variant="secondary">Back to home</Button>
            <Button href="/booking" variant="primary">Book another</Button>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Layout>

<script is:inline define:vars={{ pricing: business.sessionPricing, serviceMap: Object.fromEntries(services.map((s) => [s.slug, s.name])) }}>
  (function () {
    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

    // --- state ---
    const params = new URLSearchParams(location.search);
    const state = {
      step: 1,
      location: params.get("location") === "studio" ? "studio" : "house",
      minutes: Number(params.get("minutes")) || 90,
      service: params.get("service") || "therapeutic-massage",
      date: "",
      time: "",
      name: "",
      phone: "",
      email: "",
      address: "",
      notes: "",
    };

    // --- step titles + helpers ---
    const stepTitles = {
      1: "Pick your session.",
      2: "Pick a time.",
      3: "Your details.",
      4: "Review & confirm.",
    };
    const stepHelpers = {
      1: "Pressure, pace, focus — we'll fine-tune in person.",
      2: "Times shown are currently open. Text for same-day.",
      3: "I never share your info. Card is charged after the session.",
      4: "No charge until after your session.",
    };
    const nextLabels = { 1: "Continue →", 2: "Continue →", 3: "Continue →", 4: "Confirm booking →" };

    // --- helpers ---
    function priceFor() {
      const row = pricing.find((p) => p.minutes === state.minutes) || pricing[1];
      return state.location === "house" ? row.houseCallPrice : row.studioPrice;
    }
    function prettyDate(iso) {
      if (!iso) return "—";
      const d = new Date(iso + "T00:00");
      return d.toLocaleString("en", { weekday: "short", month: "short", day: "numeric" });
    }
    function setActive(group, value) {
      $$(`[data-group="${group}"] .step-option`).forEach((b) => {
        b.dataset.active = b.dataset.value === String(value) ? "true" : "false";
      });
    }

    // --- build day strip dynamically ---
    function buildDays() {
      const strip = $("[data-days-strip]");
      if (!strip || strip.childElementCount) return;
      const now = new Date();
      for (let i = 0; i < 10; i++) {
        const d = new Date(now);
        d.setDate(now.getDate() + i);
        const iso = d.toISOString().slice(0, 10);
        const isSun = d.getDay() === 0;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "step-option shrink-0 w-16 rounded-xl border border-stone-200 bg-white p-3 text-center shadow-sm transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:ring-1 data-[active=true]:ring-sage/40 disabled:opacity-30 disabled:cursor-not-allowed";
        btn.dataset.value = iso;
        btn.disabled = isSun;
        btn.innerHTML =
          `<p class="text-[10px] font-semibold uppercase tracking-wide text-ink/60">${d.toLocaleString("en", { weekday: "short" })}</p>` +
          `<p class="mt-0.5 text-xl font-semibold text-ink">${d.getDate()}</p>` +
          `<p class="text-[10px] font-semibold uppercase tracking-wide text-ink/60">${d.toLocaleString("en", { month: "short" })}</p>`;
        strip.appendChild(btn);
      }
    }

    // --- render ---
    function render() {
      // step visibility
      $$("[data-step]").forEach((el) => {
        el.classList.toggle("hidden", Number(el.dataset.step) !== state.step);
      });
      $("[data-step-num]").textContent = String(state.step);
      $("[data-step-title]").textContent = stepTitles[state.step];
      $("[data-helper]").textContent = stepHelpers[state.step];
      $("[data-next-label]").textContent = nextLabels[state.step];

      // back label
      $("[data-back-label]").textContent = state.step === 1 ? "Back to home" : "Previous step";

      // step dots
      const dots = $$("[data-step-dots] > span");
      dots.forEach((dot, i) => {
        dot.className = "h-1 rounded-full transition-all " +
          (i === state.step - 1 ? "w-8 bg-sage" : i < state.step - 1 ? "w-1.5 bg-sage/60" : "w-1.5 bg-stone-300");
      });

      // duration prices reflect location
      $$('[data-group="minutes"] .step-option').forEach((btn) => {
        const priceEl = btn.querySelector("[data-dur-price]");
        if (priceEl) {
          priceEl.textContent = "$" + (state.location === "house" ? btn.dataset.housePrice : btn.dataset.studioPrice);
        }
      });

      // address field visibility
      const addrWrap = $('[data-field-wrap="address"]');
      if (addrWrap) addrWrap.classList.toggle("hidden", state.location !== "house");

      // summary
      const price = priceFor();
      const serviceName = serviceMap[state.service] || "Therapeutic";
      $("[data-summary-title]").textContent = `${serviceName} · ${state.minutes} min`;
      $("[data-summary-location]").textContent = state.location === "house" ? "House call" : "Studio session";
      $("[data-summary-when]").textContent = state.date && state.time ? `${prettyDate(state.date)} · ${state.time}` : "—";
      $("[data-summary-where]").textContent = state.location === "house" ? (state.address || "Your address") : "Private studio · downtown";
      $("[data-summary-name]").textContent = state.name || "—";
      $("[data-summary-price]").textContent = "$" + price;
      $("[data-summary-total]").textContent = "$" + price;

      // review
      if (state.step === 4) {
        $("[data-review-session]").textContent = `${serviceName} · ${state.minutes} min`;
        $("[data-review-when]").textContent = state.date && state.time ? `${prettyDate(state.date)} at ${state.time}` : "—";
        $("[data-review-where]").textContent = state.location === "house" ? (state.address || "Your place") : "Private studio · downtown";
        $("[data-review-name]").textContent = state.name || "—";
        $("[data-review-contact]").textContent = [state.phone, state.email].filter(Boolean).join(" · ") || "—";
        const notesWrap = $("[data-review-notes-wrap]");
        if (state.notes) {
          notesWrap.classList.remove("hidden");
          $("[data-review-notes]").textContent = state.notes;
        } else {
          notesWrap.classList.add("hidden");
        }
      }

      // sync URL (non-destructive)
      const url = new URL(location.href);
      url.searchParams.set("minutes", String(state.minutes));
      url.searchParams.set("location", state.location);
      url.searchParams.set("service", state.service);
      history.replaceState(null, "", url.toString());
    }

    function canAdvance() {
      if (state.step === 1) return state.location && state.minutes && state.service;
      if (state.step === 2) return state.date && state.time;
      if (state.step === 3) {
        const base = state.name && state.phone && state.email;
        return state.location === "studio" ? base : base && state.address;
      }
      return true;
    }

    // --- wiring ---
    function wire() {
      // generic group option buttons
      $$("[data-group]").forEach((group) => {
        const key = group.dataset.group;
        group.addEventListener("click", (e) => {
          const btn = e.target.closest(".step-option");
          if (!btn || btn.disabled) return;
          const v = btn.dataset.value;
          state[key] = key === "minutes" ? Number(v) : v;
          setActive(key, v);
          render();
        });
      });

      // field inputs
      $$("[data-field]").forEach((input) => {
        input.addEventListener("input", (e) => {
          const name = e.target.getAttribute("name");
          state[name] = e.target.value;
          render();
        });
      });

      // next
      const nextBtn = $("[data-next-label]").closest("a, button");
      // Button.astro renders <button> when no href — force button behavior
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault();
        if (!canAdvance()) {
          nextBtn.animate(
            [{ transform: "translateX(0)" }, { transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "translateX(0)" }],
            { duration: 220 },
          );
          return;
        }
        if (state.step < 4) {
          state.step += 1;
          render();
          window.scrollTo({ top: 0, behavior: "smooth" });
          return;
        }
        // submit
        $("[data-confirmed-email]").textContent = state.email || "your email";
        const wizardWrap = $("[data-booking-wizard-wrap]");
        if (wizardWrap) wizardWrap.classList.add("hidden");
        $("[data-confirmed]").classList.remove("hidden");
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      // back
      $("[data-back]").addEventListener("click", (e) => {
        if (state.step === 1) return; // let link to "/" work
        e.preventDefault();
        state.step -= 1;
        render();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // --- init ---
    buildDays();
    setActive("location", state.location);
    setActive("minutes", state.minutes);
    setActive("service", state.service);
    wire();
    render();
  })();
</script>
