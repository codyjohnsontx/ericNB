---
// src/components/sections/TrustStrip.astro — UPDATED
// Replaces the thin TrustBadgeRow with a 6-column credentials grid
// (label · value · hint). Matches the prototype's trust bar.

import Section from "../ui/Section.astro";
import { business } from "../../content/business";

const items = [
  { label: "License", value: business.texasLicenseNumber.split(" ")[0], hint: "Texas LMT — verifiable with TDLR" },
  { label: "Therapist", value: business.therapistName.split(",")[0], hint: "One therapist, start to finish" },
  { label: "Hours", value: "Tue–Sat", hint: "By appointment" },
  { label: "Payment", value: "Card · HSA/FSA", hint: "Apple Pay & Google Pay" },
  { label: "Cancellation", value: "24 hours", hint: "Fair for both of us" },
  { label: "Travel", value: `${business.travel.radiusMiles} mi radius`, hint: "Included in house-call rate" },
];
---

<Section class="border-y border-stone-200 bg-white !py-10 sm:!py-12">
  <dl class="grid grid-cols-2 gap-x-8 gap-y-6 md:grid-cols-3 lg:grid-cols-6">
    {
      items.map((it) => (
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-wide text-clay-deep">{it.label}</dt>
          <dd class="mt-1 text-sm font-semibold text-ink">{it.value}</dd>
          <p class="mt-0.5 text-xs text-ink/60">{it.hint}</p>
        </div>
      ))
    }
  </dl>
</Section>
