---
// src/components/sections/Hero.astro — UPDATED
// Drop-in replacement. Replaces the right-hand "A local massage therapist..." card
// with <HeroBooker />. Left column unchanged in spirit but tightened slightly.

import Button from "../ui/Button.astro";
import HeroBooker from "./HeroBooker.astro";
import { business } from "../../content/business";
import { BOOKING_PATH } from "../../lib/routes";
---

<section class="border-b border-stone-200 bg-gradient-to-b from-paper to-paper-soft">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-sage/30 bg-sage/10 px-3 py-1 text-xs font-semibold text-sage-dark">
          <span class="h-1.5 w-1.5 rounded-full bg-sage"></span>
          <span>Booking same-week in </span>
          <span data-hero-same-week-month></span>
        </p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-6xl">
          {business.hero.headline}
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink/80 sm:text-lg">
          {business.hero.supporting}
        </p>
        <ul class="mt-6 space-y-2 text-sm text-ink/70">
          <li>
            <span class="font-semibold text-ink">Private studio sessions</span> for focused, uninterrupted care.
          </li>
          <li>
            <span class="font-semibold text-ink">House calls</span> when home is the calmest place for your body to settle.
          </li>
          <li>
            <span class="font-semibold text-ink">Service area:</span> {business.serviceAreaSummary}
          </li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={BOOKING_PATH} variant="primary" class="sm:min-w-[200px]">Book online</Button>
          <Button href={`tel:${business.phoneTel}`} variant="secondary" class="sm:min-w-[200px]">
            Text / Call {business.phoneDisplay}
          </Button>
        </div>
        <p class="mt-4 text-xs text-ink/55">{business.responseTimeNote}</p>
      </div>

      <HeroBooker />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const el = document.querySelector("[data-hero-same-week-month]");
    if (el) el.textContent = new Date().toLocaleString("default", { month: "long" });
  })();
</script>
