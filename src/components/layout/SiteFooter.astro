---
import { business } from "../../content/business";

const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-3">
    <div>
      <p class="text-sm font-semibold text-ink">{business.businessName}</p>
      <p class="mt-2 text-sm leading-relaxed text-ink/70">{business.tagline}</p>
      <p class="mt-4 text-xs text-ink/60">{business.streetAddress}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Hours</p>
      <ul class="mt-3 space-y-2 text-sm text-ink/70">
        {business.hours.map((h) => (
          <li class="flex items-start justify-between gap-4">
            <span class="font-medium text-ink/80">{h.days}</span>
            <span class="text-right">{h.hours}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Contact</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="font-medium text-sage hover:text-sage-dark" href={`tel:${business.phoneTel}`}>
            {business.phoneDisplay}
          </a>
          <span class="text-ink/60"> · text-friendly</span>
        </li>
        <li>
          <a class="font-medium text-sage hover:text-sage-dark" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </li>
        <li class="text-ink/70">
          <a class="underline decoration-sage/30 underline-offset-4 hover:decoration-sage" href="/contact">
            Service area & directions notes
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-stone-200 bg-paper-soft">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-ink/60 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} {business.businessName}. All rights reserved.</p>
      <p class="max-w-prose">
        {business.therapistName} · {business.texasLicenseNumber}
      </p>
    </div>
  </div>
</footer>
