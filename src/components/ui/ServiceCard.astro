---
interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
}

const { href, title, description, meta } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-card transition hover:-translate-y-0.5 hover:border-stone-300"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-semibold tracking-tight text-ink group-hover:text-sage-dark">{title}</h3>
    <span class="text-sm font-semibold text-sage" aria-hidden="true">→</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-ink/75">{description}</p>
  {meta ? <p class="mt-4 text-xs font-medium text-clay-deep">{meta}</p> : null}
</a>
