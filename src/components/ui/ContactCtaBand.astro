---
import Button from "./Button.astro";
import { business } from "../../content/business";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ready to book?",
  description = "Pick a time online, or text if you have a quick question about house calls or scheduling.",
} = Astro.props;
---

<div class="rounded-3xl border border-stone-200 bg-gradient-to-b from-white to-paper-soft px-6 py-10 shadow-card sm:px-10">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink/75 sm:text-base">{description}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <Button href={business.bookingUrl} variant="primary" class="sm:min-w-[180px]" rel="noopener noreferrer" target="_blank">
        Book online
      </Button>
      <Button href={`tel:${business.phoneTel}`} variant="secondary" class="sm:min-w-[180px]">
        Text / Call {business.phoneDisplay}
      </Button>
    </div>
  </div>
</div>
