---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  class?: string;
  /** Use h1 for the page’s primary heading (one per page). Defaults to h2. */
  titleTag?: "h1" | "h2";
}

const { id, eyebrow, title, description, class: className = "", titleTag = "h2" } = Astro.props;
const titleClass =
  titleTag === "h1"
    ? "mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
    : "mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl";
---

<section id={id} class={`py-14 sm:py-16 ${className}`}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      eyebrow || title || description ? (
        <header class="max-w-3xl">
          {eyebrow ? (
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">{eyebrow}</p>
          ) : null}
          {title ? (
            titleTag === "h1" ? (
              <h1 class={titleClass}>{title}</h1>
            ) : (
              <h2 class={titleClass}>{title}</h2>
            )
          ) : null}
          {description ? (
            <p class="mt-4 text-base leading-relaxed text-ink/80">{description}</p>
          ) : null}
        </header>
      ) : null
    }
    <div class={eyebrow || title || description ? "mt-10" : ""}>
      <slot />
    </div>
  </div>
</section>
