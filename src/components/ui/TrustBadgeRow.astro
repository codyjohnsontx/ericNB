---
interface Props {
  items: readonly string[] | string[];
}

const { items } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    items.map((item) => (
      <li class="flex items-start gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm text-ink/80 shadow-sm">
        <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-paper-soft text-xs font-bold text-sage" aria-hidden="true">✓</span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
