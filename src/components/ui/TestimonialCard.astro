---
interface Props {
  name: string;
  quote: string;
  serviceType?: string;
  tags?: string[];
}

const { name, quote, serviceType, tags = [] } = Astro.props;
---

<figure class="h-full rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
  <blockquote class="text-sm leading-relaxed text-ink/85">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="mt-5 text-sm text-ink/70">
    <span class="font-semibold text-ink">{name}</span>
    {serviceType ? <span class="text-ink/50"> · {serviceType}</span> : null}
  </figcaption>
  {
    tags.length ? (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
        {tags.map((t) => (
          <li class="rounded-full bg-paper-soft px-3 py-1 text-xs font-medium text-ink/70">{t}</li>
        ))}
      </ul>
    ) : null
  }
</figure>
