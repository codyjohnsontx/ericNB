---
// src/components/sections/HeroBooker.astro
// Replaces the right-hand card in Hero.astro with a live booking widget:
// location + duration + style picker → live price → deep-link to /booking.
// Pure Astro + vanilla JS (no frameworks). Reads prices from business.ts.

import Button from "../ui/Button.astro";
import { business } from "../../content/business";
import { services } from "../../content/booking-wizard-services";
import { BOOKING_PATH } from "../../lib/routes";

/** Runtime guard — `business` uses `as const`, so TS sees a fixed-length tuple; widen for a safe empty check. */
const pricing = business.sessionPricing as ReadonlyArray<{
  minutes: number;
  studioPrice: number;
  houseCallPrice: number;
}>;
if (!Array.isArray(pricing) || pricing.length === 0) {
  throw new Error(
    "[HeroBooker] business.sessionPricing must be a non-empty array. Add session rows in src/content/business.ts.",
  );
}
const defaultPricing = pricing.find((p) => p.minutes === 90) ?? pricing[0];
const defaultMinutes = defaultPricing.minutes;
const mostBookedIndex = pricing.findIndex((p) => p.minutes === 90);
const defaultServiceSlug = services[0].slug;
const initialHouse = true;
const initialPrice = initialHouse ? defaultPricing.houseCallPrice : defaultPricing.studioPrice;
---

<div
  id="hero-booker"
  class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8"
  data-prices={JSON.stringify(pricing)}
  data-booking-path={BOOKING_PATH}
  data-default-service={defaultServiceSlug}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Book a session</p>
  <h2 class="mt-2 text-xl font-semibold tracking-tight text-ink">Design your hour.</h2>
  <p class="mt-1 text-sm text-ink/70">Location, length, focus. Price updates live.</p>

  {/* Location */}
  <fieldset class="mt-6">
    <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Where</legend>
    <div
      class="mt-3 grid grid-cols-2 gap-2"
      data-group="location"
      role="radiogroup"
      aria-label="Session location"
    >
      <button
        type="button"
        role="radio"
        aria-checked="true"
        tabindex="0"
        data-value="house"
        class="booker-option rounded-xl border border-stone-200 bg-paper-soft p-3 text-left transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:bg-white data-[active=true]:ring-1 data-[active=true]:ring-sage/50"
        data-active="true"
      >
        <p class="text-sm font-semibold text-ink">Your place</p>
        <p class="mt-0.5 text-xs text-ink/65">I drive to you · within {business.travel.radiusMiles} mi</p>
      </button>
      <button
        type="button"
        role="radio"
        aria-checked="false"
        tabindex="-1"
        data-value="studio"
        data-active="false"
        class="booker-option rounded-xl border border-stone-200 bg-paper-soft p-3 text-left transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:bg-white data-[active=true]:ring-1 data-[active=true]:ring-sage/50"
      >
        <p class="text-sm font-semibold text-ink">Studio</p>
        <p class="mt-0.5 text-xs text-ink/65">Downtown {business.city}</p>
      </button>
    </div>
  </fieldset>

  {/* Duration */}
  <fieldset class="mt-5">
    <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">How long</legend>
    <div
      class="mt-3 grid grid-cols-3 gap-2"
      data-group="minutes"
      role="radiogroup"
      aria-label="Session length in minutes"
    >
      {
        pricing.map((p, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={p.minutes === defaultMinutes ? "true" : "false"}
            tabindex={p.minutes === defaultMinutes ? 0 : -1}
            data-value={p.minutes}
            class="booker-option rounded-xl border border-stone-200 bg-paper-soft p-2.5 text-center transition hover:border-stone-300 data-[active=true]:border-sage data-[active=true]:bg-white data-[active=true]:ring-1 data-[active=true]:ring-sage/50"
            data-active={p.minutes === defaultMinutes ? "true" : "false"}
          >
            <p class="text-2xl font-semibold leading-none tracking-tight text-ink">{p.minutes}</p>
            <p class="mt-1 text-[10px] font-semibold uppercase tracking-wide text-ink/60">minutes</p>
            {mostBookedIndex >= 0 && i === mostBookedIndex ? (
              <p class="mt-1 text-[9px] font-semibold uppercase tracking-wide text-sage">Most booked</p>
            ) : null}
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* Style */}
  <fieldset class="mt-5">
    <legend class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Style</legend>
    <div
      class="mt-3 flex flex-wrap gap-1.5"
      data-group="service"
      role="radiogroup"
      aria-label="Massage style"
    >
      {
        services.map((s) => (
          <button
            type="button"
            role="radio"
            aria-checked={s.slug === defaultServiceSlug ? "true" : "false"}
            tabindex={s.slug === defaultServiceSlug ? 0 : -1}
            data-value={s.slug}
            class="booker-option rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 transition hover:border-stone-300 data-[active=true]:border-transparent data-[active=true]:bg-sage data-[active=true]:text-white"
            data-active={s.slug === defaultServiceSlug ? "true" : "false"}
          >
            {s.name}
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* Summary + CTA */}
  <div class="mt-6 flex items-end justify-between gap-3 border-t border-stone-200 pt-5">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-wide text-clay-deep">Your session</p>
      <p class="mt-1 flex items-baseline gap-1.5">
        <span class="text-3xl font-semibold tracking-tight text-ink" data-price>${initialPrice}</span>
        <span class="text-xs text-ink/60" data-summary
          >· {defaultMinutes} min · at your place</span
        >
      </p>
    </div>
    <Button
      href={`${BOOKING_PATH}?minutes=${defaultMinutes}&location=house&service=${defaultServiceSlug}`}
      variant="primary"
      class="!px-5"
    >
      <span data-cta-label>Continue</span>
    </Button>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById("hero-booker");
    if (!root) return;

    const bookingPath = root.dataset.bookingPath || "/booking";
    const defaultService = root.dataset.defaultService || "therapeutic-massage";
    const prices = JSON.parse(root.dataset.prices || "[]") as Array<{
      minutes: number;
      studioPrice: number;
      houseCallPrice: number;
    }>;
    if (!Array.isArray(prices) || prices.length === 0) {
      console.error("[HeroBooker] session pricing payload is empty.");
      return;
    }
    const defaultPricing = prices.find((p) => p.minutes === 90) ?? prices[0];
    if (!defaultPricing) return;

    const state = {
      location: "house" as "house" | "studio",
      minutes: defaultPricing.minutes,
      service: defaultService,
    };

    const priceEl = root.querySelector("[data-price]") as HTMLElement;
    const summaryEl = root.querySelector("[data-summary]") as HTMLElement;
    const ctaEl = root.querySelector(`a[href^="${bookingPath}"]`) as HTMLAnchorElement;

    function syncRadios(group: HTMLElement, activeValue: string | number) {
      const opts = Array.from(group.querySelectorAll<HTMLButtonElement>("button.booker-option"));
      opts.forEach((btn) => {
        const on = btn.dataset.value === String(activeValue);
        btn.dataset.active = on ? "true" : "false";
        btn.setAttribute("aria-checked", on ? "true" : "false");
        btn.tabIndex = on ? 0 : -1;
      });
    }

    function selectInGroup(group: HTMLElement, value: string | number, key: keyof typeof state) {
      (state as any)[key] = key === "minutes" ? Number(value) : value;
      syncRadios(group, value);
      render();
    }

    function focusAdjacent(group: HTMLElement, stateKey: keyof typeof state, dir: 1 | -1) {
      const opts = Array.from(group.querySelectorAll<HTMLButtonElement>("button.booker-option")).filter(
        (b) => !b.disabled,
      );
      const i = opts.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0 || !opts.length) return;
      const next = (i + dir + opts.length) % opts.length;
      const btn = opts[next];
      if (!btn) return;
      const v = btn.dataset.value!;
      selectInGroup(group, stateKey === "minutes" ? Number(v) : v, stateKey);
      btn.focus();
    }

    function render() {
      const row = prices.find((p) => p.minutes === state.minutes) ?? defaultPricing;
      const price = state.location === "house" ? row.houseCallPrice : row.studioPrice;
      priceEl.textContent = `$${price}`;
      summaryEl.textContent = `· ${state.minutes} min · ${state.location === "house" ? "at your place" : "at the studio"}`;
      const params = new URLSearchParams({
        minutes: String(state.minutes),
        location: state.location,
        service: state.service,
      });
      ctaEl.href = `${bookingPath}?${params.toString()}`;
    }

    root.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      const key = group.dataset.group as keyof typeof state;

      group.querySelectorAll<HTMLButtonElement>("button.booker-option").forEach((btn) => {
        btn.addEventListener("click", () => {
          const v = btn.dataset.value!;
          selectInGroup(group, key === "minutes" ? Number(v) : v, key);
        });
      });

      group.addEventListener("keydown", (e) => {
        const opts = Array.from(group.querySelectorAll<HTMLButtonElement>("button.booker-option")).filter(
          (b) => !b.disabled,
        );
        if (!opts.length) return;
        const keyEv = e.key;
        if (keyEv === "ArrowRight" || keyEv === "ArrowDown") {
          e.preventDefault();
          focusAdjacent(group, key, 1);
        } else if (keyEv === "ArrowLeft" || keyEv === "ArrowUp") {
          e.preventDefault();
          focusAdjacent(group, key, -1);
        } else if (keyEv === " " || keyEv === "Enter") {
          const focused = document.activeElement as HTMLButtonElement | null;
          if (focused && group.contains(focused) && focused.classList.contains("booker-option")) {
            e.preventDefault();
            const v = focused.dataset.value!;
            selectInGroup(group, key === "minutes" ? Number(v) : v, key);
          }
        } else if (keyEv === "Home") {
          e.preventDefault();
          const first = opts[0];
          if (first) {
            const v = first.dataset.value!;
            selectInGroup(group, key === "minutes" ? Number(v) : v, key);
            first.focus();
          }
        } else if (keyEv === "End") {
          e.preventDefault();
          const last = opts[opts.length - 1];
          if (last) {
            const v = last.dataset.value!;
            selectInGroup(group, key === "minutes" ? Number(v) : v, key);
            last.focus();
          }
        }
      });
    });

    render();
  })();
</script>
