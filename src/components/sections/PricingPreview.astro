---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { business } from "../../content/business";

const starter = business.sessionPricing[0];
---

<Section
  eyebrow="Pricing"
  title="Clear starting prices — studio and house calls"
  description="Rates are listed plainly so you can book with confidence. Add-ons and travel outside the included radius may adjust the total — details on the Pricing page."
  class="bg-paper-soft"
>
  <div class="grid gap-6 lg:grid-cols-3 lg:items-end">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
      <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Studio session</p>
      <p class="mt-3 text-3xl font-semibold tracking-tight text-ink">
        ${starter.studioPrice}
        <span class="text-base font-semibold text-ink/60">/ {starter.minutes} min</span>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink/75">Private session in a calm New Braunfels studio setting.</p>
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
      <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">House call session</p>
      <p class="mt-3 text-3xl font-semibold tracking-tight text-ink">
        ${starter.houseCallPrice}
        <span class="text-base font-semibold text-ink/60">/ {starter.minutes} min</span>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink/75">
        In-home massage in New Braunfels within the included travel radius (travel policy on Pricing).
      </p>
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
      <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Popular upgrades</p>
      <p class="mt-3 text-sm font-semibold text-ink">90–120 minute sessions</p>
      <p class="mt-3 text-sm leading-relaxed text-ink/75">
        Longer sessions are ideal when you want both focused therapeutic work and time to downshift.
      </p>
      <div class="mt-5">
        <Button href="/pricing" variant="primary" class="w-full sm:w-auto">See full pricing</Button>
      </div>
    </div>
  </div>
</Section>
