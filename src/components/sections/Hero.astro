---
import Button from "../ui/Button.astro";
import { business } from "../../content/business";
---

<section class="border-b border-stone-200 bg-gradient-to-b from-paper to-paper-soft">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">New Braunfels, Texas</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {business.hero.headline}
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink/80 sm:text-lg">
          {business.hero.supporting}
        </p>
        <ul class="mt-6 space-y-2 text-sm text-ink/70">
          <li>
            <span class="font-semibold text-ink">Private studio sessions</span> for focused, uninterrupted care.
          </li>
          <li>
            <span class="font-semibold text-ink">House calls</span> when home is the calmest place for your body to
            settle.
          </li>
          <li>
            <span class="font-semibold text-ink">Service area:</span> {business.serviceAreaSummary}
          </li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={business.bookingUrl} variant="primary" class="sm:min-w-[200px]" rel="noopener noreferrer" target="_blank">
            Book now
          </Button>
          <Button href={`tel:${business.phoneTel}`} variant="secondary" class="sm:min-w-[200px]">
            Text / Call {business.phoneDisplay}
          </Button>
        </div>
        <p class="mt-4 text-xs text-ink/55">{business.responseTimeNote}</p>
      </div>

      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
        <p class="text-sm font-semibold text-ink">A local massage therapist for real-world goals</p>
        <p class="mt-3 text-sm leading-relaxed text-ink/75">
          Whether you are looking for <a class="font-medium text-sage hover:text-sage-dark" href="/services/therapeutic-massage"
            >therapeutic massage in New Braunfels</a
          >, deep tissue work, prenatal comfort sessions, or a slower relaxation massage, sessions are built around your
          preferences — not a scripted spa routine.
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <a class="rounded-xl border border-stone-200 bg-paper-soft p-4 text-sm hover:border-stone-300" href="/pricing">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Transparent pricing</p>
            <p class="mt-2 font-semibold text-ink">See starting rates</p>
            <p class="mt-1 text-xs text-ink/65">Studio + house call options</p>
          </a>
          <a class="rounded-xl border border-stone-200 bg-paper-soft p-4 text-sm hover:border-stone-300" href="/booking">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Straightforward booking</p>
            <p class="mt-2 font-semibold text-ink">Pick time + location</p>
            <p class="mt-1 text-xs text-ink/65">Online scheduling</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
