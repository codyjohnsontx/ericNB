---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import { business } from "../content/business";

const title = "Contact CTX Massage";
const description =
  "Call or text, email, review the New Braunfels service area, hours, and response expectations — plus a lightweight contact form stub.";
---

<Layout title={title} description={description} path="/contact" includeLocalJsonLd={true}>
  <Section
    eyebrow="Contact"
    title="Reach the studio"
    description="Fastest responses are usually text between sessions. Email is fine for non-urgent questions."
    class="bg-gradient-to-b from-paper to-paper-soft"
    titleTag="h1"
  >
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Phone & email</h2>
        <dl class="mt-4 space-y-4 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Phone / text</dt>
            <dd class="mt-2">
              <a class="text-base font-semibold text-sage hover:text-sage-dark" href={`tel:${business.phoneTel}`}>
                {business.phoneDisplay}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Email</dt>
            <dd class="mt-2">
              <a class="font-semibold text-sage hover:text-sage-dark" href={`mailto:${business.email}`}>{business.email}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-clay-deep">Response time</dt>
            <dd class="mt-2 text-ink/75">{business.responseTimeNote}</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <Button href={`sms:${business.phoneTel}`} variant="primary">Text the studio</Button>
          <Button href="/booking" variant="secondary">Book online</Button>
        </div>
      </div>

      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Hours</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink/75">
          {
            business.hours.map((h) => (
              <li class="flex items-start justify-between gap-4">
                <span class="font-semibold text-ink/80">{h.days}</span>
                <span class="text-right">{h.hours}</span>
              </li>
            ))
          }
        </ul>
        <h2 class="mt-8 text-lg font-semibold text-ink">Service area</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink/75">
          {business.serviceAreas.map((a) => <li>{a}</li>)}
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-ink/70">{business.serviceAreaSummary}</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="Map" title="Service map (placeholder)" class="bg-white">
    <div class="rounded-3xl border border-dashed border-stone-300 bg-paper-soft p-10 text-center">
      <p class="text-sm font-semibold text-ink">Map embed placeholder</p>
      <p class="mt-2 text-sm text-ink/70">
        Many local sites embed Google Maps for the studio address. Add your public address + embed code here when ready (keep privacy in mind for home-based studios).
      </p>
    </div>
  </Section>

  <Section eyebrow="Form" title="Send a message (stub)" class="bg-paper-soft">
    <div class="max-w-2xl rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
      <p class="text-sm leading-relaxed text-ink/75">
        This form is a UI stub for v1 (no backend endpoint). When you are ready, wire it to a form provider (Basin, Formspark, Netlify Forms) or replace with a mailto link.
      </p>
      <form class="mt-6 space-y-4" aria-describedby="form-stub-note">
        <p id="form-stub-note" class="sr-only">This form does not submit anywhere yet.</p>
        <div>
          <label class="text-sm font-semibold text-ink" for="name">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-sm text-ink shadow-sm"
            disabled
          />
        </div>
        <div>
          <label class="text-sm font-semibold text-ink" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-sm text-ink shadow-sm"
            disabled
          />
        </div>
        <div>
          <label class="text-sm font-semibold text-ink" for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows={5}
            class="mt-2 w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-sm text-ink shadow-sm"
            disabled></textarea>
        </div>
        <Button variant="secondary" class="w-full sm:w-auto" aria-disabled="true">Send (disabled)</Button>
      </form>
      <p class="mt-4 text-xs text-ink/60">
        For now, email <a class="font-semibold text-sage hover:text-sage-dark" href={`mailto:${business.email}`}>{business.email}</a> directly.
      </p>
    </div>
  </Section>

  <Section class="bg-white pb-16">
    <div class="rounded-3xl border border-stone-200 bg-gradient-to-b from-white to-paper-soft p-8 shadow-card">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Ready to schedule?</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink/75">If your question is mostly scheduling, booking online is usually fastest.</p>
      <div class="mt-6">
        <Button href="/booking" variant="primary">Book online</Button>
      </div>
    </div>
  </Section>
</Layout>
