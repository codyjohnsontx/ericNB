---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import PricingTable from "../components/ui/PricingTable.astro";
import ContactCtaBand from "../components/ui/ContactCtaBand.astro";
import Button from "../components/ui/Button.astro";
import { business } from "../content/business";

const title = "Massage pricing in New Braunfels, TX";
const description =
  "Transparent session pricing for studio appointments and house calls, plus travel notes, add-ons placeholder, gift cards, and cancellation summary.";
---

<Layout title={title} description={description} path="/pricing">
  <Section
    eyebrow="Pricing"
    title="Straightforward rates for studio and house calls"
    description="These numbers are realistic placeholders — swap them for your live menu when you finalize pricing and connect booking checkout."
    class="bg-gradient-to-b from-paper to-paper-soft"
    titleTag="h1"
  >
    <PricingTable rows={business.sessionPricing} />
    <p class="mt-4 text-xs text-ink/60">If your booking platform shows slightly different totals, the checkout page is the final source of truth.</p>
  </Section>

  <Section eyebrow="Add-ons" title="Optional upgrades" class="bg-white">
    <div class="max-w-3xl rounded-2xl border border-stone-200 bg-paper-soft p-6 text-sm leading-relaxed text-ink/80">
      {business.addOns.note}
    </div>
  </Section>

  <Section eyebrow="Travel" title="House call travel radius & fees" class="bg-paper-soft">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
        <h2 class="text-lg font-semibold text-ink">Included radius</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink/75">
          House calls include travel within about <span class="font-semibold text-ink">{business.travel.radiusMiles} miles</span> of downtown New Braunfels, unless noted otherwise at booking.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-ink/75">{business.travel.feeOutsideNote}</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-card">
        <h2 class="text-lg font-semibold text-ink">Setup expectations</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink/75">{business.travel.parkingNote}</p>
        <div class="mt-6">
          <Button href="/contact" variant="secondary">Confirm your address</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section eyebrow="Gift cards" title="Gift massage sessions" class="bg-white">
    <div class="max-w-3xl rounded-2xl border border-stone-200 bg-paper-soft p-6 text-sm leading-relaxed text-ink/80">
      {business.giftCards.note}
    </div>
  </Section>

  <Section eyebrow="Policies" title="Cancellation summary" class="bg-paper-soft">
    <div class="max-w-3xl rounded-2xl border border-stone-200 bg-white p-6 text-sm leading-relaxed text-ink/80 shadow-card">
      {business.cancellation.summary}
    </div>
  </Section>

  <Section class="bg-white pb-16">
    <ContactCtaBand title="Book with transparent pricing" description="Choose your session length and location type online. If you are on the edge of the travel radius, text before you book." />
  </Section>
</Layout>
