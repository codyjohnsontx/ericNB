---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import { business } from "../content/business";

const title = "Book massage therapy in New Braunfels";
const description =
  "Choose studio or house call massage, review prep and policies, then confirm online — with call/text fallback if booking fails.";

const embedActive = Boolean(business.bookingEmbedUrl);
---

<Layout title={title} description={description} path="/booking">
  <Section
    eyebrow="Booking"
    title="Book online in a few minutes"
    description="This page is designed for conversion: clear choices, realistic expectations, and a direct path to your scheduling provider."
    class="bg-gradient-to-b from-paper to-paper-soft"
    titleTag="h1"
  >
    <div class="mt-8 grid gap-6 lg:grid-cols-2 lg:items-start">
      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
        <h2 class="text-lg font-semibold text-ink">Guided choices (then confirm online)</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink/75">
          Most booking tools will ask for the same basics. Choose what matches your plan here so the online flow feels faster.
        </p>

        <div class="mt-6 space-y-6">
          <div id="step-service">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">1. Session focus</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/therapeutic-massage">Therapeutic</a>
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/deep-tissue-massage">Deep tissue</a>
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/prenatal-massage">Prenatal</a>
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/sports-massage">Sports</a>
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/relaxation-massage">Relaxation</a>
              <a class="rounded-full border border-stone-200 bg-paper-soft px-3 py-1 text-xs font-semibold text-ink/80 hover:border-stone-300" href="/services/house-call-massage">House call info</a>
            </div>
          </div>

          <div id="step-duration">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">2. Duration</p>
            <p class="mt-2 text-sm text-ink/75">
              First visit? <span class="font-semibold text-ink">60 minutes</span> is enough for focused work. Choose{" "}
              <span class="font-semibold text-ink">90–120 minutes</span> when you want deeper relaxation time plus targeted areas.
            </p>
          </div>

          <div id="step-location">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">3. Location type</p>
            <ul class="mt-3 space-y-2 text-sm text-ink/75">
              <li>
                <span class="font-semibold text-ink">Studio:</span> best for a quiet, controlled environment.
              </li>
              <li>
                <span class="font-semibold text-ink">House call:</span> best when home is calmer — confirm space and travel on the{" "}
                <a class="font-medium text-sage hover:text-sage-dark" href="/pricing">Pricing</a> page.
              </li>
            </ul>
          </div>

          <div id="step-confirm">
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-deep">4. Date / time + checkout</p>
            <p class="mt-2 text-sm text-ink/75">
              Your booking provider will show availability in real time. Checkout may include a cancellation policy and card/deposit requirements — especially for house calls.
            </p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
              <Button href={business.bookingUrl} variant="primary" rel="noopener noreferrer" target="_blank">Continue to online booking</Button>
              <Button href={`tel:${business.phoneTel}`} variant="secondary">Text / Call for help</Button>
            </div>
          </div>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-card sm:p-8">
          <h2 class="text-lg font-semibold text-ink">Before you arrive</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink/75">
            <li>Hydrate normally, but skip a heavy meal right beforehand.</li>
            <li>Wear comfortable clothing; draping is used throughout the session.</li>
            <li>For house calls, clear a setup path and choose a room with space for a table.</li>
            <li>Mention injuries, surgeries, pregnancy, or provider restrictions during intake.</li>
          </ul>
        </div>

        <div class="rounded-3xl border border-stone-200 bg-paper-soft p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-ink">Deposits & cancellations</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/75">{business.payments.depositNote}</p>
          <p class="mt-4 text-sm leading-relaxed text-ink/75">{business.cancellation.summary}</p>
        </div>

        <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-ink">If booking fails</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/80">
            Sometimes calendars glitch on mobile. If the booking page will not load, text{" "}
            <a class="font-semibold text-sage hover:text-sage-dark" href={`sms:${business.phoneTel}`}>{business.phoneDisplay}</a>{" "}
            with your preferred session type, location (studio vs house call), and a few times that work.
          </p>
        </div>
      </aside>
    </div>
  </Section>

  <Section eyebrow="Online scheduling" title="Booking window (embed or link)" class="bg-white">
    <p class="max-w-3xl text-sm leading-relaxed text-ink/75">
      Paste your Square Appointments or Acuity embed URL into <span class="font-semibold text-ink">bookingEmbedUrl</span> in{" "}
      <code class="rounded bg-paper-soft px-1 py-0.5 text-xs">src/content/business.ts</code>. Until then, this area shows a safe placeholder.
    </p>

    <div class="mt-6 overflow-hidden rounded-2xl border border-dashed border-stone-300 bg-paper-soft">
      {
        embedActive ? (
          <iframe
            title="Online booking"
            src={business.bookingEmbedUrl}
            class="h-[720px] w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        ) : (
          <div class="p-10 text-center">
            <p class="text-sm font-semibold text-ink">Embed placeholder</p>
            <p class="mt-2 text-sm text-ink/70">Add your HTTPS embed URL to enable inline booking.</p>
            <div class="mt-6">
              <Button href={business.bookingUrl} variant="primary" rel="noopener noreferrer" target="_blank">
                Open booking in a new tab
              </Button>
            </div>
          </div>
        )
      }
    </div>
  </Section>

  <Section class="bg-paper-soft pb-16">
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-card">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Prefer human help?</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink/75">{business.responseTimeNote}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button href={`tel:${business.phoneTel}`} variant="secondary">Call {business.phoneDisplay}</Button>
        <Button href={`sms:${business.phoneTel}`} variant="ghost">Send a text</Button>
      </div>
    </div>
  </Section>
</Layout>
