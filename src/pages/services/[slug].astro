---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection } from "astro:content";
import { business } from "../../content/business";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const { Content } = await service.render();

const title = `${service.data.title} in New Braunfels, TX`;
const description = service.data.description;

function houseCallText() {
  if (service.data.houseCalls === "yes") return "House calls are available within the travel area described on Pricing.";
  if (service.data.houseCalls === "limited") return "House calls may be available on a case-by-case basis depending on setup and scheduling.";
  return "This service is primarily offered in-studio for setup and safety reasons.";
}
---

<Layout title={title} description={description} path={`/services/${service.slug}`}>
  <Section
    eyebrow="Service"
    title={`${service.data.title} in ${business.city}`}
    description={service.data.description}
    class="bg-gradient-to-b from-paper to-paper-soft"
    titleTag="h1"
  >
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={business.bookingUrl} variant="primary" rel="noopener noreferrer" target="_blank">Book this service</Button>
        <Button href={`tel:${business.phoneTel}`} variant="secondary">Text / Call</Button>
      </div>
      <p class="text-sm text-ink/65">
        <a class="font-medium text-sage hover:text-sage-dark" href="/services">Back to services</a>
      </p>
    </div>
  </Section>

  <Section eyebrow="Who it is for" title="Best fit" class="bg-white">
    <p class="max-w-3xl text-sm leading-relaxed text-ink/80">{service.data.whoItsFor}</p>
  </Section>

  <Section eyebrow="Benefits" title="What clients commonly notice" class="bg-paper-soft">
    <ul class="grid gap-3 md:grid-cols-3">
      {service.data.benefits.map((b) => (
        <li class="rounded-2xl border border-stone-200 bg-white p-5 text-sm leading-relaxed text-ink/80 shadow-sm">{b}</li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Durations & pricing" title="Session options" description="Prices shown are placeholders until your live menu is connected to booking." class="bg-white">
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-card">
      <table class="min-w-full divide-y divide-stone-200 text-left text-sm">
        <caption class="sr-only">Durations and pricing for this service</caption>
        <thead class="bg-paper-soft text-xs font-semibold uppercase tracking-wide text-clay-deep">
          <tr>
            <th scope="col" class="px-4 py-3 sm:px-6">Session</th>
            <th scope="col" class="px-4 py-3 sm:px-6">Studio</th>
            <th scope="col" class="px-4 py-3 sm:px-6">House call</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {
            service.data.durations.map((d) => (
              <tr>
                <th scope="row" class="px-4 py-4 font-semibold text-ink sm:px-6">
                  {d.label}
                </th>
                <td class="px-4 py-4 text-ink/80 sm:px-6">${d.studioPrice}</td>
                <td class="px-4 py-4 text-ink/80 sm:px-6">${d.houseCallPrice}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section eyebrow="What to expect" title="Session flow" class="bg-paper-soft">
    <p class="max-w-3xl text-sm leading-relaxed text-ink/80">{service.data.expectations}</p>
  </Section>

  <Section eyebrow="House calls" title="In-home availability" class="bg-white">
    <p class="max-w-3xl text-sm leading-relaxed text-ink/80">{houseCallText()}</p>
    {service.data.houseCallNote ? <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink/80">{service.data.houseCallNote}</p> : null}
    <div class="mt-6">
      <Button href="/pricing" variant="secondary">Review travel pricing</Button>
    </div>
  </Section>

  <Section eyebrow="Details" title="More context" class="bg-paper-soft">
    <div class="prose-local max-w-3xl text-sm">
      <Content />
    </div>
  </Section>

  <Section class="bg-white pb-16">
    <div class="rounded-3xl border border-stone-200 bg-gradient-to-b from-white to-paper-soft p-8 shadow-card">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Book {service.data.title.toLowerCase()} online</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/75">
        Choose this session type in your booking flow, then select studio or house call depending on what you need that day.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button href={business.bookingUrl} variant="primary" rel="noopener noreferrer" target="_blank">Open booking</Button>
        <Button href="/booking" variant="ghost">Booking FAQs & prep</Button>
      </div>
    </div>
  </Section>
</Layout>
